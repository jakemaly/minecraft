{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://minecraft-agent.invalid/schemas/program.v1.json",
  "title": "Workspace Mineflayer program request and result",
  "oneOf": [
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["version", "method", "source", "script", "timeout_seconds"],
      "properties": {
        "version": {"const": 1},
        "method": {"const": "run_program"},
        "source": {"type": "string", "minLength": 1, "maxLength": 262144},
        "script": {"type": "string", "maxLength": 200},
        "timeout_seconds": {"type": "number", "minimum": 1, "maximum": 43200}
      }
    },
    {
      "type": "object",
      "additionalProperties": false,
      "required": ["status", "program_id", "script", "sha256", "output", "duration_seconds", "controls_released"],
      "properties": {
        "status": {"enum": ["completed", "cancelled", "error"]},
        "program_id": {"type": ["string", "null"]},
        "script": {"type": ["string", "null"]},
        "sha256": {"type": ["string", "null"]},
        "output": {"type": "array", "items": {"type": "object"}},
        "duration_seconds": {"type": "number", "minimum": 0},
        "controls_released": {"type": "boolean"},
        "result": {},
        "error_type": {"type": "string"},
        "error": {"type": "string"}
      }
    }
  ]
}
