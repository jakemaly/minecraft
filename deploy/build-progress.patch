+test("a dig that leaves the active portal in place is refused and the rest of the build proceeds", async () => {
+  const { bot, put, physics } = structureWorld();
+  const portal = new Vec3(2, 64, 0);
+  put(portal, "nether_portal");
+  const world = flatWorld();
+  world.load(portal, { stateId: bot.registry.blocksByName.nether_portal!.defaultState,
+    traits: { empty: true, safeToBreak: false } });
+  const digger = new FakeNavigationBot();
+  digger.startEffect = () => { throw new Error("cannot dig the active portal"); };
+  let attempts = 0;
+  const result = await build(bot, {
+    ...physics,
+    cells: [...cells([[2, 64, 0]], "air"), ...cells([[3, 64, 0]])],
+    removeWrongBlocks: false,
+    breakInPlace: async (options) => {
+      assert.equal(++attempts, 1, "the unchanged portal must not be dug again");
+      return breakBlockInPlace({ world, bot: digger }, options);
+    },
+  });
+  assert.deepEqual(kinds(result), ["refused", "correct"]);
+  assert.equal(result.dug, 0);
+  assert.equal(result.placed, 1);
+  assert.equal(bot.blockAt(portal)?.name, "nether_portal");
+});
