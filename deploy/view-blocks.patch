+test("dense Nether block counts stay below the runtime heartbeat deadline", () => {
+  const netherrack = registry.blocksByName.netherrack!;
+  const uniform = { solidBlockCount: 4096, data: { value: netherrack.defaultState }, get: () => netherrack.defaultState };
+  const mixed = {
+    solidBlockCount: 1, data: {}, palette: [0, netherrack.defaultState],
+    get: ({ x, y, z }: Vec3) => x === 0 && y === 0 && z === 0 ? netherrack.defaultState : 0,
+  };
+  const column = { minY: 0, sections: [...Array(8).fill(uniform), mixed] };
+  const columns = Array.from({ length: 441 }, (_, index) => ({
+    chunkX: Math.floor(index / 21) - 28, chunkZ: index % 21 - 27, column,
+  }));
+  const bot = botFixture({ position: new Vec3(-290, 44, -266) }, {
+    world: { getColumns: () => columns },
+    blockAt: (position: Vec3) => ({ name: netherrack.name, position, boundingBox: netherrack.boundingBox }),
+  });
+  const request = parseViewBlocksRequest({ find: { block_names: ["netherrack"], limit: 3 } });
+  const start = performance.now();
+  const result = viewBlocks(bot, request);
+  const elapsed = performance.now() - start;
+  assert.ok(elapsed < 5000, `view_blocks blocked the event loop for ${elapsed.toFixed(0)} ms`);
+  const match = result.blocks.find?.[0];
+  assert.equal(match?.found, 441 * (8 * 4096 + 1));
+  assert.deepEqual(match?.listed.map(({ x, y, z }) => [x, y, z]), [
+    [-290, 44, -266], [-290, 43, -266], [-290, 44, -267],
+  ]);
+});
+
