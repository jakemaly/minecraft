+      }],
+    };
+    assert.deepEqual(decideFightBoundary(observed, defence, refuge), { kind: "recover", health: 18 });
+    const exposed = { ...refuge, returnable: false };
+    const response = decideFightBoundary(observed, defence, exposed);
+    assert.equal(response.kind === "respond" && response.response.kind, "hide");
