@@ -178,6 +178,30 @@ test("terminal work competes with travel even when it can start at the root", ()
   assert.equal(plan.steps.length, 2);
 });

+test("a node limit bounds retained states even before the compute budget is spent", () => {
+  const limits = { maximumNodes: 12, failureTimeoutMs: 5000 };
+  const wide = searchOver(
+    goalOf("unreachable", () => 0),
+    stubCatalogue((state) => Array.from({ length: 40 }, (_, index) => graphMovement(state, 1, index, 1))),
+    { limits },
+  );
+  const stopped = wide.advance();
+  assert.equal(stopped.kind, "limit");
+  if (stopped.kind !== "limit") return;
+  assert.equal(stopped.limit.kind, "nodes");
+  assert.equal(stopped.evidence.generated, limits.maximumNodes);
+  assert.equal(stopped.evidence.computeMs, 0);
+
+  const line = searchOver(
+    goalOf("distant", (node) => 40 - node.feet.x, (node) => node.feet.x === 40),
+    stubCatalogue((state) => state.node.feet.x < 40 ? [graphMovement(state, state.node.feet.x + 1, 0, 1)] : []),
+    { limits },
+  );
+  const prefix = expect(line.advance(), "segment_ready");
+  assert.equal(prefix.evidence.generated, limits.maximumNodes);
+  assert.equal(prefix.plan.end.x, 11);
+});
+
